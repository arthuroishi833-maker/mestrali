# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# O arquivo .env NUNCA vai para o git (veja .gitignore).
#
# Onde achar: painel do Supabase > Project Settings > API (ou "API Keys").
# Use a chave pública ("anon" / "publishable"). NUNCA use a "service_role" / "secret".

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-publica-aqui

# ---------------------------------------------------------------------
# OPCIONAL: só para os testes com o Supabase de verdade
# (tests/test_supabase_real.py). Sem estas linhas, esses testes são pulados.
#
# Crie DOIS usuários só de teste no painel do Supabase
# (Authentication > Users > Add user, marcando "Auto Confirm User")
# e coloque aqui o e-mail e a senha deles. NUNCA use uma conta de verdade
# (nem a sua): os testes gravam e apagam dados, trocam a senha da conta 1
# e encerram as sessões das duas contas.
# ---------------------------------------------------------------------
TESTE_EMAIL_1=
TESTE_SENHA_1=
TESTE_EMAIL_2=
TESTE_SENHA_2=
# Trava de segurança: os testes só rodam se esta linha disser "sim".
# Escreva "sim" SOMENTE se as duas contas acima foram criadas só para teste.
TESTE_CONTAS_DESCARTAVEIS=
